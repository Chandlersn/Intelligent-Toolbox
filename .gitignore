# 数据文件（本地优先，不进版本库）
*.db
*.db.bak.*
*.db.bak
# WAL 模式产生的伴生文件（db.py 统一开 WAL 后出现）
*.db-wal
*.db-shm

# Python 缓存
__pycache__/
*.pyc

# 工作记忆（项目私有）
.workbuddy/

# 依赖
node_modules/
# 进本项目方案：抖音转录依赖（本机自带、不进版本库）
.venv/
bin/
# 下载缓存的音视频（抖音转录中间产物）
media/
media/**
# 本地 whisper 模型权重（curl 从镜像拉取，139MB，不进版本库）
models/
# 服务运行日志
server.log
