{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoCollectorFloat",
  "version": "0.1.0",
  "identifier": "com.repocollector.float",
  "build": {
    "beforeDevCommand": "python3 -m http.server 4321 --directory ../src",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "收藏箱",
        "width": 280,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["repocollector"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {
      "associatedSchemes": ["repocollector"]
    },
    "windows": {
      "protocol": {
        "schemes": ["repocollector"]
      }
    }
  }
}
