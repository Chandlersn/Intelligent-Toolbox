{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8732",
      "http://127.0.0.1:8732/*",
      "http://localhost:8732",
      "http://localhost:8732/*"
    ]
  },
  "permissions": [
    "core:default",
    "deep-link:default",
    "deep-link:allow-is-registered",
    "deep-link:allow-register",
    "clipboard-manager:allow-read-text"
  ]
}
